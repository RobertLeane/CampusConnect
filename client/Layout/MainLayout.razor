        <li><NavLink href="/events">Find Events</NavLink></li>
        <li><NavLink href="/dashboard">My Dashboard</NavLink></li>
      </ul>
    </div>
    <div>
      <h5>Support</h5>
      <ul>
        <li><a href="#">Help Center</a></li>
        <li><a href="#">Contact Us</a></li>
      </ul>
    </div>
  </div>
