root = true

[*.cs]
# Naming conventions
dotnet_naming_rule.interfaces_should_be_pascal_case.severity = warning
dotnet_naming_rule.interfaces_should_be_pascal_case.symbols = interface
dotnet_naming_rule.interfaces_should_be_pascal_case.style = pascal_case_style

# Architecture rules
dotnet_diagnostic.CA1001.severity = error  # Types that own disposable fields
dotnet_diagnostic.CA1031.severity = warning # Do not catch general exceptions
dotnet_diagnostic.CA1822.severity = suggestion # Mark members as static
dotnet_diagnostic.CA2007.severity = error  # Always use ConfigureAwait