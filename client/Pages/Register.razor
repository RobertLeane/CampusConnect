@page "/register"

@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<section class="hero center">
    <div class="container">
        <h1>Create Your Account</h1>
        <p>Join clubs, RSVP to events, and build your campus profile.</p>
    </div>
</section>

<main class="container auth-container">
    <EditForm Model="model" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <div class="auth-card">
            <h2>Sign Up</h2>

            <div class="auth-row">
                <div class="auth-field">
                    <label for="firstName">First name</label>
                    <InputText id="firstName" @bind-Value="model.FirstName" placeholder="First name" />
                    <ValidationMessage For="() => model.FirstName" />
                </div>
                <div class="auth-field">
                    <label for="lastName">Last name</label>
                    <InputText id="lastName" @bind-Value="model.LastName" placeholder="Last name" />
                    <ValidationMessage For="() => model.LastName" />
                </div>
            </div>

            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="model.Email" type="email" placeholder="abc@email.com" />
                <ValidationMessage For="() => model.Email" />
            </div>

            <div class="auth-field">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="model.Password" type="password" placeholder="At least 8 characters" />
                <ValidationMessage For="() => model.Password" />
            </div>

            <div class="auth-field">
                <label for="confirm">Confirm password</label>
                <InputText id="confirm" @bind-Value="confirm" type="password" placeholder="Repeat your password" />
                @if (!string.IsNullOrEmpty(confirmError))
                {
                    <div class="alert alert-error">@confirmError</div>
                }
            </div>


            <div class="auth-field">
                <button type="submit" class="btn" disabled="@submitting">
                    <span>@(submitting ? "Creating..." : "Create Account")</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(serverMessage))
            {
                <div class="@(GetMessageClass())">
                    @serverMessage
                </div>
            }

            <p class="auth-links">
                Already have an account? <a href="/login">Log in</a>
            </p>
        </div>
    </EditForm>
</main>

@code {
    private RegisterVm model = new();
    private string confirm = string.Empty;

    private bool submitting;
    private string? serverMessage;
    private bool isSuccess;

    private string? confirmError;

    private string GetMessageClass()
    {
        return isSuccess ? "alert alert-success" : "alert alert-error";
    }

    private async Task OnSubmit()
    {
        serverMessage = null;
        confirmError = null;
        isSuccess = false;

       
        if (!string.Equals(model.Password, confirm, StringComparison.Ordinal))
        {
            confirmError = "Passwords do not match.";
            return;
        }

        submitting = true;
        try
        {
            var payload = new RegisterRequest
            {
                FirstName = model.FirstName,
                LastName = model.LastName,
                Email = model.Email,
                Password = model.Password
            };

            var resp = await Http.PostAsJsonAsync("/api/auth/register", payload);
            if (resp.IsSuccessStatusCode)
            {
                isSuccess = true;
                serverMessage = "Account created successfully! Redirecting to login...";
                model = new();
                confirm = string.Empty;
                
                // Navigate to login after a brief delay
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else if ((int)resp.StatusCode == 409)
            {
                isSuccess = false;
                serverMessage = "An account with this email already exists. Please use a different email or try logging in.";
            }
            else if ((int)resp.StatusCode == 400)
            {
                isSuccess = false;
                var text = await resp.Content.ReadAsStringAsync();
                serverMessage = "Please check your information and try again.";
            }
            else
            {
                isSuccess = false;
                serverMessage = "Registration failed. Please try again later.";
            }
        }
        catch (Exception)
        {
            isSuccess = false;
            serverMessage = "Unable to create account. Please check your internet connection and try again.";
        }
        finally
        {
            submitting = false;
        }
    }

    public class RegisterVm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(50)]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(50)]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(255, MinimumLength = 8)]
        public string Password { get; set; } = string.Empty;
    }

    public class RegisterRequest
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
