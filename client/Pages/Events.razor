z@page "/events"

<PageTitle>Events</PageTitle>

<section class="hero">
    <div class="container">
        <h1>What’s On <span>This Week</span></h1>
        <p>Talks, meetups, workshops, socials, and more. Find your next campus event.</p>

        <form class="hero-search">
            <input type="search" placeholder="Search by title, club, or tag…" />
            <button type="button">Search</button>
        </form>

        <div class="stats">
            <div class="stat">
                <div class="stat__num">42</div>
                <div class="stat__label">This Week</div>
            </div>
            <div class="stat">
                <div class="stat__num">120+</div>
                <div class="stat__label">This Month</div>
            </div>
            <div class="stat">
                <div class="stat__num">20</div>
                <div class="stat__label">Clubs Hosting</div>
            </div>
        </div>
    </div>
</section>

<!-- Content -->
<main class="container layout">
    <section class="results">
        <div class="section-head">
            <h2>Events</h2>
        </div>

        <div class="grid grid-3">

            <!-- Event 1 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-ai/800/480" alt="AI for Beginners workshop" />
                </div>
                <div class="card__body">
                    <h3>AI for Beginners — Hands-on</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Computer Science Society</li>
                        <li><strong>Time:</strong> Thu · 18:30–20:30</li>
                        <li><strong>Venue:</strong> CS Building · Lab 2</li>
                    </ul>
                    <div class="tags">
                        <span>Workshop</span><span>Python</span><span>Beginners</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

            <!-- Event 2 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-photo/800/480" alt="Sunset Photo Walk" />
                </div>
                <div class="card__body">
                    <h3>Sunset Photo Walk</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Photography Club</li>
                        <li><strong>Time:</strong> Sat · 17:30–19:00</li>
                        <li><strong>Venue:</strong> Riverside Park</li>
                    </ul>
                    <div class="tags">
                        <span>Outdoors</span><span>Creativity</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

            <!-- Event 3 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-vol/800/480" alt="Campus Food Drive" />
                </div>
                <div class="card__body">
                    <h3>Campus Food Drive</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Volunteer Corps</li>
                        <li><strong>Time:</strong> Mon · 10:00–16:00</li>
                        <li><strong>Venue:</strong> Student Union Hall</li>
                    </ul>
                    <div class="tags">
                        <span>Community</span><span>Charity</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

            <!-- Event 4 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-hike/800/480" alt="Weekend Hike — Trail Day" />
                </div>
                <div class="card__body">
                    <h3>Weekend Hike — Trail Day</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Hiking & Outdoors</li>
                        <li><strong>Time:</strong> Sun · 08:00–14:00</li>
                        <li><strong>Venue:</strong> Blue Ridge Trail</li>
                    </ul>
                    <div class="tags">
                        <span>Fitness</span><span>Nature</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

            <!-- Event 5 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-debate/800/480" alt="Intervarsity Debate Night" />
                </div>
                <div class="card__body">
                    <h3>Intervarsity Debate Night</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Debate Society</li>
                        <li><strong>Time:</strong> Tue · 18:00–20:00</li>
                        <li><strong>Venue:</strong> Lecture Theatre A</li>
                    </ul>
                    <div class="tags">
                        <span>Public Speaking</span><span>Competition</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

            <!-- Event 6 -->
            <article class="card">
                <div class="card__media">
                    <img src="https://picsum.photos/seed/event-green/800/480" alt="Repair Café" />
                </div>
                <div class="card__body">
                    <h3>Repair Café</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> Sustainability Society</li>
                        <li><strong>Time:</strong> Fri · 16:00–18:00</li>
                        <li><strong>Venue:</strong> Maker Space</li>
                    </ul>
                    <div class="tags">
                        <span>Green</span><span>DIY</span><span>Community</span>
                    </div>
                    <div class="actions">
                        <a href="#" class="btn">RSVP</a>
                    </div>
                </div>
            </article>

        </div>
    </section>
</main>