@page "/events"
@using Client.Models
@using Client.Services
@inject ClubApi ClubApi
@inject EventApi EventApi
@inject UserApi UserApi
@inject EventRegistrationService EventRegistration
@inject AuthService AuthService
@inject IJSRuntime JS


<section class="hero">
  <div class="container">
    <h1>What’s On <span>This Week</span></h1>
    <p>Talks, meetups, workshops, socials, and more. Find your next campus event.</p>
    <div class="stats">
      <div class="stat">
          <div class="stat__num">@clubsCount.Count</div>
          <div class="stat__label">Active Clubs</div>
            </div>
          <div class="stat">
              <div class="stat__num">@eventsCount.Count</div>
              <div class="stat__label">Events</div>
          </div>
          <div class="stat">
              <div class="stat__num">@usersCount.Count</div>
              <div class="stat__label">Active Members</div>
          </div>
      </div>
  </div>
</section>

<main class="container layout">
  <section class="results">
    <div class="section-head"><h2>Events</h2></div>

    <div class="grid grid-3">
      @if (events is null)
      {
        <p>Loading…</p>
      }
      else if (events.Count == 0)
      {
        <p>No events found.</p>
      }
      else
      {
        @foreach (var ev in events)
        {
          <article class="card">
            <div class="card__media">
            <img src="@(!string.IsNullOrEmpty(ev.EventImgURL) ? ev.EventImgURL : "/images/default-event.jpg")" alt="@ev.EventName" onerror="this.onerror=null;this.src='/images/AI for Beginners.jpg';" />
            </div>
            <div class="card__body">
              <h3 class="card__title">@ev.EventName</h3>
              <p class="card__date">@ev.EventDateTime.ToString("f")</p>
              <p class="card__description">@ev.EventDescription</p>
              <button class="btn btn--primary" @onclick="() => HandleRsvpClickAsync(ev.EventId, ev.ClubId)">RSVP For Event</button>
            </div>
          </article>
        }
      }
    </div>
  </section>
</main>

@code {
  private List<Event>? events;

 protected override async Task OnInitializedAsync()
  {
    try
    {
      // Initialize authentication state
      await AuthService.InitializeAsync();
      
      events = await EventApi.GetEventsAsync();
      
      // Load stats data
      clubsCount = await ClubApi.GetClubsAsync();
      eventsCount = await EventApi.GetEventsAsync();
      usersCount = await UserApi.GetUsersAsync();
    }
    catch (Exception ex)
    {
      events = new();
      await JS.InvokeVoidAsync("alert", $"Could not load events: {ex.Message}");
    }
  }

  private int CurrentUserId => AuthService.CurrentUser?.UserId ?? 0;

  private async Task HandleRsvpClickAsync(int eventId, int clubId)
  {
    if (!AuthService.IsAuthenticated || CurrentUserId == 0)
    {
      await JS.InvokeVoidAsync("alert", "Please log in to RSVP for events.");
      return;
    }
    
    await EventRegistration.HandleRsvpAsync(eventId, clubId, CurrentUserId);
  }
  
}

@code {

    private List<Club> clubsCount = new();
    private List<Event> eventsCount = new();
    private List<User> usersCount = new();
}
