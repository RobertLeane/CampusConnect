@page "/events"

<PageTitle>Events</PageTitle>

<section class="hero">
    <div class="container">
        <h1>What’s On <span>This Week</span></h1>
        <p>Talks, meetups, workshops, socials, and more. Find your next campus event.</p>

        <form class="hero-search">
            <input type="search" placeholder="Search by title, club, or tag…" />
            <button type="button">Search</button>
        </form>

        <div class="stats">
            <div class="stat">
                <div class="stat__num">42</div>
                <div class="stat__label">This Week</div>
            </div>
            <div class="stat">
                <div class="stat__num">120+</div>
                <div class="stat__label">This Month</div>
            </div>
            <div class="stat">
                <div class="stat__num">20</div>
                <div class="stat__label">Clubs Hosting</div>
            </div>
        </div>
    </div>
</section>

<!-- Content -->
<main class="container layout">
    <section class="results">
        <div class="section-head">
            <h2>Events</h2>
        </div>

        <div class="grid grid-3">

        @forEach (var event in events)
        {
            <article class="card">
                <div class="card__media">
                    <img src="@event.ImageUrl" alt="@event.Title" />
                </div>
                <div class="card__body">
                    <h3>@event.Title</h3>
                    <ul class="meta">
                        <li><strong>Hosted by:</strong> @event.Host</li>
                        <li><strong>Time:</strong> @event.Time</li>
                        <li><strong>Venue:</strong> @event.Venue</li>
                    </ul>
                    <div class="tags">
                    @foreach (var tag in event.Tags)
                    {
                        <span>@tag</span>
                    }
                    </div>
                    <div class="actions">
                         <button class="btn" @onclick="() => OnRSVPClicked(evt)">RSVP</button>
                    </div>
                    @if (!string.IsNullOrEmpty(event.Message))
                    {
                        <div class="alert alert-warning mt-2">@evt.Message</div>
                    }
        }
           
                </div>
            </article>

        </div>
    </section>
</main>
