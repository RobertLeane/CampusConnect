@page "/about"
@using Client.Models
@using Client.Services
@inject ClubApi ClubApi
@inject EventApi EventApi
@inject UserApi UserApi
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>About</PageTitle>

<section class="hero">
    <div class="container">
        <h1>About <span>Campus Connect</span></h1>
        <p>Join clubs, attend events, and connect with fellow students. Your college experience starts here.</p>

        <div class="stats">
        <div class="stat">
          <div class="stat__num">@clubsCount.Count</div>
          <div class="stat__label">Active Clubs</div>
            </div>
          <div class="stat">
              <div class="stat__num">@eventsCount.Count</div>
              <div class="stat__label">Events</div>
          </div>
          <div class="stat">
              <div class="stat__num">@usersCount.Count</div>
              <div class="stat__label">Active Members</div>
          </div>
      </div>
    </div>
</section>

<!-- Content -->
<main class="container layout">
    
</main>

@code{
    private List<Club> clubsCount = new();
    private List<Event> eventsCount = new();
    private List<User> usersCount = new();
    private bool isLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initialize authentication state
            await AuthService.InitializeAsync();
            
            // Load stats data
            clubsCount = await ClubApi.GetClubsAsync();
            eventsCount = await EventApi.GetEventsAsync();
            usersCount = await UserApi.GetUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading stats: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }
}
