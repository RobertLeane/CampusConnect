@page "/"
@using Client.Models
@using Client.Services
@inject ClubApi ClubApi

<PageTitle>Home</PageTitle>

<!-- Hero -->
<section class="hero">
    <div class="container">
        <h1>Discover Your <span>Campus Community</span></h1>
        <p>Join clubs, attend events, and connect with fellow students. Your college experience starts here.</p>
        <form class="hero-search">
            <input type="search" placeholder="Search for clubs, events, or interests..." />
            <button type="button">Search</button>
        </form>

        <div class="stats">
            <div class="stat">
                <div class="stat__num">@clubs.Count</div>
                <div class="stat__label">Active Clubs</div>
            </div>
            <div class="stat">
                <div class="stat__num">10+</div>
                <div class="stat__label">Monthly Events</div>
            </div>
            <div class="stat">
                <div class="stat__num">5k+</div>
                <div class="stat__label">Active Members</div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Clubs -->
<section class="container">
    <div class="section-head">
        <h2>Featured Clubs</h2>
        <a href="club.html" class="link-btn">View All Clubs</a>
    </div>

    @if (isLoading)
        {
            <div class="loading">Loading clubs...</div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error">@errorMessage</div>
        }
        else if (!clubs.Any())
        {
            <div class="no-results">No clubs found.</div>
        }
        else
        {
            <div class="grid grid-3">
                @foreach (var club in clubs.Take(3))
                {
                    <article class="card">
                        <div class="card__media">
                            <img src="@GetClubImage(club)" alt="@club.ClubName cover" onerror="this.src='@GetFallbackImage(club)'" />
                        </div>
                        <div class="card__body">
                            <h3>@club.ClubName</h3>
                            <p>@(club.ClubDescription ?? "No description available.")</p>
                            <div class="actions">
                                <a href="#" class="btn">Join Club</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
</section>

<!-- Upcoming Events -->
<section class="container">
    <div class="section-head">
        <h2>Upcoming Events</h2>
        <a href="#" class="link-btn">View All Events</a>
    </div>

    <div class="grid grid-2">
        <!-- Event 1 -->
        <article class="card">
            <div class="card__media card__media--wide">
                <img src="https://picsum.photos/seed/event1/1100/480" alt="Tech Conference" />
            </div>
            <div class="card__body">
                <h3>Annual Tech Conference</h3>
                <p class="sub">by Computer Science Society</p>
                <p>Keynotes, workshops, and networking opportunities in technology.</p>
                <ul class="meta">
                    <li>Oct 18, 2024</li>
                    <li>9:00 AM – 5:00 PM</li>
                    <li>Engineering Auditorium</li>
                    <li>145/200 attending</li>
                </ul>
                <div class="actions">
                    <a href="#" class="btn">Register</a>
                </div>
            </div>
        </article>

        <!-- Event 2 -->
        <article class="card">
            <div class="card__media card__media--wide">
                <img src="https://picsum.photos/seed/event2/1100/480" alt="Photography Workshop" />
            </div>
            <div class="card__body">
                <h3>Photography Workshop: Portrait Lighting</h3>
                <p class="sub">by Photography Club</p>
                <p>Learn professional portrait lighting techniques with hands-on practice.</p>
                <ul class="meta">
                    <li>Oct 20, 2024</li>
                    <li>2:00 PM – 5:00 PM</li>
                    <li>Art Studio 205</li>
                    <li>12/15 attending</li>
                </ul>
                <div class="actions">
                    <a href="#" class="btn">Register</a>
                </div>
            </div>
        </article>
    </div>
</section>

<!-- Categories + CTA -->
<section class="container">
    <h2 class="center">Explore by Category</h2>
    <div class="chips">
        <span class="chip">Technology</span>
        <span class="chip">Arts &amp; Culture</span>
        <span class="chip">Sports</span>
        <span class="chip">Community Service</span>
        <span class="chip">Professional</span>
        <span class="chip">Environment</span>
    </div>

    <div class="cta">
        <h3>Ready to Get Involved?</h3>
        <p>Join the vibrant campus community. Connect with students, develop new skills, and create lasting memories.</p>
        <div class="cta-actions">
            <NavLink href="/Dashboard" class="btn btn--primary">View My Dashboard</NavLink>
            <NavLink href="/clubs" class="btn btn--light">Explore Clubs</NavLink>
        </div>
    </div>
</section>

@code {
    private List<Club> clubs = new();
    private bool isLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("Starting to load clubs...");
            clubs = await ClubApi.GetClubsAsync();
            Console.WriteLine($"Loaded {clubs.Count} clubs");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading clubs: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetClubImage(Club club)
    {
        // Use the club's image URL from Azure Blob Storage if available
        if (!string.IsNullOrEmpty(club.ClubImgURL))
        {
            // URL decode the image URL to handle encoded characters like %20 and %26
            var decodedUrl = Uri.UnescapeDataString(club.ClubImgURL);
            Console.WriteLine($"Original URL: {club.ClubImgURL}");
            Console.WriteLine($"Decoded URL: {decodedUrl}");
            return decodedUrl;
        }
        
        // Fallback to a placeholder if no image URL is provided
        return GetFallbackImage(club);
    }
    
    private string GetFallbackImage(Club club)
    {
        // Generate a consistent placeholder image based on club name
        return $"https://picsum.photos/seed/{club.ClubName.ToLower().Replace(" ", "-")}/800/480";
    }
}