@page "/"
@using Client.Models
@using Client.Services
@inject ClubApi ClubApi
@inject EventApi EventApi
@inject UserApi UserApi
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<!-- Hero -->
<section class="hero">
    <div class="container">
        <h1>Discover Your <span>Campus Community</span></h1>
        <p>Join clubs, attend events, and connect with fellow students. Your college experience starts here.</p>

        <div class="stats">
            <div class="stat">
                <div class="stat__num">@clubs.Count</div>
                <div class="stat__label">Active Clubs</div>
            </div>
            <div class="stat">
                <div class="stat__num">@events.Count</div>
                <div class="stat__label">Events</div>
            </div>
            <div class="stat">
                <div class="stat__num">@users.Count</div>
                <div class="stat__label">Active Members</div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Clubs -->
<section class="container">
    <div class="section-head">
        <h2>Featured Clubs</h2>
        <NavLink href='/Clubs'class="link-btn">View All clubs</NavLink>
    </div>

    @if (isLoading)
        {
            <div class="loading">Loading clubs...</div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error">@errorMessage</div>
        }
        else if (!clubs.Any())
        {
            <div class="no-results">No clubs found.</div>
        }
        else
        {
            <div class="grid grid-3">
                @foreach (var club in clubs.Take(3))
                {
                    <article class="card">
                        <div class="card__media">
                            <img src="@GetClubImage(club)" alt="@club.ClubName cover" onerror="this.src='@GetFallbackImage(club)'" />
                        </div>
                        <div class="card__body">
                            <h3>@club.ClubName</h3>
                            <p>@(club.ClubDescription ?? "No description available.")</p>
                            <div class="actions">
                                <a href="#" class="btn">Join Club</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
</section>

<!-- Upcoming Events -->
<section class="container">
    <div class="section-head">
        <h2>Featured Events</h2>
        <NavLink href="/Events" class="link-btn">View All Events</NavLink>
    </div>

    @if (eventsLoading)
    {
        <div class="loading">Loading events...</div>
    }
    else if (!events.Any())
    {
        <div class="no-results">No events found.</div>
    }
    else
    {
        <div class="grid grid-2">
            @foreach (var eventItem in events.Take(2))
            {
                <article class="card">
                    <div class="card__media card__media--wide">
                        <img src="@GetEventImage(eventItem)" alt="@eventItem.EventName" onerror="this.src='@GetFallbackEventImage(eventItem)'" />
                    </div>
                    <div class="card__body">
                        <h3>@eventItem.EventName</h3>
                        <p class="sub">by @GetClubName(eventItem.ClubId)</p>
                        <p>@(eventItem.EventDescription ?? "No description available.")</p>
                        <ul class="meta">
                            <li>@eventItem.EventDateTime.ToString("MMM dd, yyyy")</li>
                            <li>@eventItem.EventDateTime.ToString("h:mm tt")</li>
                        </ul>
                        <div class="actions">
                            <button class="btn btn--primary" @onclick="() => HandleRsvpClickAsync(eventItem.EventId, eventItem.ClubId)">RSVP For Event</button>
                            <a href="/events" class="btn btn--light">See more Events</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- Categories + CTA -->
<section class="container">
    <div>
    <p></p>
    </div>
    <div class="cta">
        <h3>Ready to Get Involved?</h3>
        <p>Join the vibrant campus community. Connect with students, develop new skills, and create lasting memories.</p>
        <div class="cta-actions">
            <NavLink href="/Dashboard" class="btn btn--primary">View My Dashboard</NavLink>
            <NavLink href="/clubs" class="btn btn--light">Explore Clubs</NavLink>
        </div>
    </div>
</section>

@code {
    private List<Club> clubs = new();
    private List<Event> events = new();
    private List<User> users = new();
    private Dictionary<int, string> clubNames = new();
    private bool isLoading = true;
    private bool eventsLoading = true;
    private bool usersLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initialize authentication state
            await AuthService.InitializeAsync();
            
            Console.WriteLine("Starting to load clubs...");
            clubs = await ClubApi.GetClubsAsync();
            Console.WriteLine($"Loaded {clubs.Count} clubs");
            
            // Build club name dictionary for quick lookup
            clubNames = clubs.ToDictionary(c => c.ClubId, c => c.ClubName);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading clubs: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isLoading = false;
        }

        // Load events
        try
        {
            Console.WriteLine("Starting to load events...");
            var allEvents = await EventApi.GetEventsAsync();
            Console.WriteLine($"Total events from API: {allEvents.Count}");
            
            // Debug: Print all event dates
            foreach (var ev in allEvents.Take(5))
            {
                Console.WriteLine($"Event: {ev.EventName}, Date: {ev.EventDateTime}, Current: {DateTime.Now}");
            }
            
            // Filter for events that are today or in the future (more lenient)
            var today = DateTime.Today;
            events = allEvents
                .Where(e => e.EventDateTime.Date >= today)
                .OrderBy(e => e.EventDateTime)
                .ToList();
                
            Console.WriteLine($"Loaded {events.Count} upcoming events (from {today:yyyy-MM-dd})");
            
            // If no upcoming events, show recent events for demo purposes
            if (events.Count == 0)
            {
                Console.WriteLine("No upcoming events found, showing all events for demo");
                events = allEvents
                    .OrderByDescending(e => e.EventDateTime)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading events: {ex.Message}");
        }
        finally
        {
            eventsLoading = false;
        }

        // Load users count
        try
        {
            Console.WriteLine("Starting to load users...");
            users = await UserApi.GetUsersAsync();
            Console.WriteLine($"Loaded {users.Count} users");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
        }
        finally
        {
            usersLoading = false;
        }
    }

    private int CurrentUserId => AuthService.CurrentUser?.UserId ?? 0;

    private async Task HandleRsvpClickAsync(int eventId, int clubId)
    {
        if (!AuthService.IsAuthenticated || CurrentUserId == 0)
        {
            await JS.InvokeVoidAsync("alert", "Please log in to RSVP for events.");
            return;
        }
        
        try
        {
            var response = await EventApi.RsvpAsync(eventId, CurrentUserId);
            
            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Successfully RSVP'd to the event!");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await JS.InvokeVoidAsync("alert", "You must join the club first to RSVP to this event.");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await JS.InvokeVoidAsync("alert", "You have already RSVP'd to this event.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Failed to RSVP to the event. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error RSVPing to event: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "An error occurred while RSVPing. Please try again.");
        }
    }

    private string GetClubName(int clubId)
    {
        return clubNames.TryGetValue(clubId, out var clubName) ? clubName : "Unknown Club";
    }

    private string GetClubImage(Club club)
    {
        // Use the club's image URL from Azure Blob Storage if available
        if (!string.IsNullOrEmpty(club.ClubImgURL))
        {
            // URL decode the image URL to handle encoded characters like %20 and %26
            var decodedUrl = Uri.UnescapeDataString(club.ClubImgURL);
            Console.WriteLine($"Original URL: {club.ClubImgURL}");
            Console.WriteLine($"Decoded URL: {decodedUrl}");
            return decodedUrl;
        }
        
        // Fallback to a placeholder if no image URL is provided
        return GetFallbackImage(club);
    }
    
    private string GetFallbackImage(Club club)
    {
        // Generate a consistent placeholder image based on club name
        return $"https://picsum.photos/seed/{club.ClubName.ToLower().Replace(" ", "-")}/800/480";
    }

    private string GetEventImage(Event eventItem)
    {
        // Use the event's image URL from Azure Blob Storage if available
        if (!string.IsNullOrEmpty(eventItem.EventImgURL))
        {
            // URL decode the image URL to handle encoded characters like %20 and %26
            var decodedUrl = Uri.UnescapeDataString(eventItem.EventImgURL);
            return decodedUrl;
        }
        
        // Fallback to a placeholder if no image URL is provided
        return GetFallbackEventImage(eventItem);
    }
    
    private string GetFallbackEventImage(Event eventItem)
    {
        // Generate a consistent placeholder image based on event name
        return $"https://picsum.photos/seed/{eventItem.EventName.ToLower().Replace(" ", "-")}/1100/480";
    }
}
