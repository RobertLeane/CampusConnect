{
  "$schema": "../.vscode/schemas/dab.v1.6.67.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DB_CONN')"
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": false },
    "host": {
      "mode": "production",
      "cors": { "origins": ["*"], "allow-credentials": false }
    }
  },
  "entities": {
    "Clubs": {
      "source": "Clubs",
      "permissions": [ { "role": "anonymous", "actions": ["read"] } ]
    },
    "Events": {
      "source": "Events",
      "permissions": [ { "role": "anonymous", "actions": ["read"] } ]
    }
  }
}
